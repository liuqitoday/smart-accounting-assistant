# ============================================
# AI Service Configuration (Required)
# ============================================
# OpenAI API Key (or compatible service)
SPRING_AI_OPENAI_API_KEY=sk-your-api-key-here

# OpenAI API Base URL (default: https://api.openai.com)
# For other providers (e.g., Deepseek, Azure OpenAI), change this URL
# SPRING_AI_OPENAI_BASE_URL=https://api.openai.com

# Model name (default: gpt-3.5-turbo)
# Examples:
#   - OpenAI: gpt-3.5-turbo, gpt-4
#   - Deepseek: deepseek-chat, deepseek-coder
#   - Azure: your-deployment-name
# SPRING_AI_OPENAI_MODEL=gpt-3.5-turbo

# ============================================
# Security Configuration
# ============================================
# Remember-me token signing key (generate with: openssl rand -hex 32)
REMEMBER_ME_KEY=change-me-to-random-hex-string

# Enable secure cookies (HTTPS only)
# Set to true if using HTTPS, false for local HTTP development
COOKIE_SECURE=false

# ============================================
# Server Configuration (Optional)
# ============================================
# Server port (default: 8081)
# SERVER_PORT=8081

# Database file path (docker-compose 默认: /app/data/accounting-assistant.db，含 WAL 参数)
# SPRING_DATASOURCE_URL=jdbc:sqlite:/app/data/accounting-assistant.db?journal_mode=WAL&busy_timeout=5000&synchronous=NORMAL

# ============================================
# Logging Configuration (Optional)
# ============================================
# Show SQL queries (default: false)
# SHOW_SQL=false

# Log level (default: INFO)
# LOGGING_LEVEL_ROOT=INFO
